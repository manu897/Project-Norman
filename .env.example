# Copy to .env for local dev. docker-compose reads .env automatically.

# Postgres
POSTGRES_USER=norman
POSTGRES_PASSWORD=norman
POSTGRES_DB=norman
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL used by api + ingest
DATABASE_URL=postgresql+asyncpg://norman:norman@postgres:5432/norman
ALEMBIC_DATABASE_URL=postgresql://norman:norman@postgres:5432/norman

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=carl/+/sensor/+/telemetry

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
