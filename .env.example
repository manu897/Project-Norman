# Copy to .env for local dev. docker-compose reads .env automatically.

# Postgres
POSTGRES_USER=norman
POSTGRES_PASSWORD=norman
POSTGRES_DB=norman
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL used by the api service
DATABASE_URL=postgresql+asyncpg://norman:norman@postgres:5432/norman
ALEMBIC_DATABASE_URL=postgresql://norman:norman@postgres:5432/norman

# MQTT — apps/ingest subscribes to Carl hub publishes on this broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=carl/+/+

# JWT — used for user (iOS app) auth on read endpoints
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Cloud deployment only (docker-compose.prod.yml) ---
# Caddy TLS termination + reverse proxy for the API. Ignored in local dev
# and in the home deployment.
NORMAN_DOMAIN=norman.example.com
ACME_EMAIL=you@example.com

# --- Home deployment only (docker-compose.home.yml) ---
# Cloudflare Tunnel token from one.dash.cloudflare.com → Networks → Tunnels.
# This is a credential — .env is gitignored, keep it that way.
CLOUDFLARE_TUNNEL_TOKEN=
