# Copy to .env for local dev. docker-compose reads .env automatically.

# Postgres
POSTGRES_USER=norman
POSTGRES_PASSWORD=norman
POSTGRES_DB=norman
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URL used by the api service
DATABASE_URL=postgresql+asyncpg://norman:norman@postgres:5432/norman
ALEMBIC_DATABASE_URL=postgresql://norman:norman@postgres:5432/norman

# JWT — used for user (iOS app) auth on read endpoints
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
